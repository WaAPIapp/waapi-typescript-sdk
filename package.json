{
  "name": "@waapiapp/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the WaAPI REST API",
  "keywords": [
    "waapi",
    "messaging",
    "api",
    "sdk",
    "automation",
    "chatbot",
    "typescript"
  ],
  "homepage": "https://waapi.app",
  "bugs": "https://github.com/WaAPIapp/waapi-typescript-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaAPIapp/waapi-typescript-sdk.git"
  },
  "license": "MIT",
  "author": "WaAPI <info@waapi.app>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sync:actions": "node scripts/sync-actions.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
